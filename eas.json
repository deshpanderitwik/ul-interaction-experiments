{
  "cli": {
    "version": ">= 20.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "store",
      "channel": "preview",
      "autoIncrement": true,
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "preview-hello": {
      "extends": "preview",
      "env": {
        "APP": "hello"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "ascAppId": "6782267882"
      }
    },
    "preview-hello": {
      "ios": {}
    },
    "production": {
      "ios": {}
    }
  }
}
